# Copy this file to .env and fill in real values. Do NOT commit .env.

# ---- Phase 1 ----
GROQ_API_KEY=your-groq-api-key-here

# ---- Phase 2 (Supabase) ----
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- News overlay (optional; newsdata.io free tier works server-side) ----
NEWSDATA_API_KEY=your-newsdata-io-key
# FREENEWS_API_KEY and NEWSAPI_KEY are supported as fallbacks but newsdata.io
# is the recommended primary (its keyword search returns on-theme results).
